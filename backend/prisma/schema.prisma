datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoleType {
  SUPER_ADMIN
  CONTENT_ADMIN
  EDITOR
  MARKETING
  SALES
  SUPPORT
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  name         String
  passwordHash String
  role         RoleType      @default(EDITOR)
  sessions     Session[]
  auditLogs    AuditLog[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
}

model Permission {
  id          String   @id @default(uuid())
  role        RoleType
  resource    String
  action      String   // create, read, update, delete
  createdAt   DateTime @default(now())
}

model DiagnosticLead {
  id          String             @id @default(uuid())
  leadCode    String             @unique
  company     String
  contactName String
  designation String
  email       String
  mobile      String
  category    String
  revenueBand String
  gmvBand     String
  orderVolume String?
  opModel     String?
  warehouses  String?
  challenges  String[]
  reconciled  Boolean            @default(false)
  intent      String
  timeline    String
  fitScore    Int
  fitLabel    String
  tags        String[]
  crmStatus   String             @default("PENDING")
  crmLeadId   String?
  utmSource   String?
  utmCampaign String?
  answers     DiagnosticAnswer[]
  results     DiagnosticResult[]
  createdAt   DateTime           @default(now())
}

model DiagnosticAnswer {
  id          String         @id @default(uuid())
  leadId      String
  lead        DiagnosticLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  stepNumber  Int
  question    String
  answer      String
  createdAt   DateTime       @default(now())
}

model DiagnosticResult {
  id          String         @id @default(uuid())
  leadId      String
  lead        DiagnosticLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  resultTag   String
  scoreBand   String
  createdAt   DateTime       @default(now())
}

model ContactSubmission {
  id          String   @id @default(uuid())
  name        String
  email       String
  phone       String?
  company     String?
  message     String
  status      String   @default("New") // New, Contacted, Closed
  crmSynced   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Article {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String
  body        String
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  authorId    String?
  author      Author?   @relation(fields: [authorId], references: [id])
  status      String    @default("Draft") // Draft, Published
  seoTitle    String?
  seoDesc     String?
  coverImage  String?
  tags        Tag[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CaseStudy {
  id                 String    @id @default(uuid())
  slug               String    @unique
  clientName         String
  industry           String?
  location           String?
  timeframe          String?
  categoryId         String?
  category           Category? @relation(fields: [categoryId], references: [id])
  title              String
  stats              String?
  description        String
  challenge          String?
  solution           String?
  actionTaken        String[]  @default([])
  capabilities       String[]  @default([])
  metrics            Json?
  testimonialQuote   String?
  testimonialAuthor  String?
  testimonialRole    String?
  testimonialCompany String?
  result             String?
  coverImage         String?
  isFeatured         Boolean   @default(false)
  isPublished        Boolean   @default(true)
  seoTitle           String?
  seoDesc            String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime? @updatedAt
}

model FAQ {
  id          String    @id @default(uuid())
  question    String
  answer      String
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  isPublished Boolean   @default(true)
  orderIndex  Int       @default(0)
  createdAt   DateTime  @default(now())
}

model Category {
  id          String      @id @default(uuid())
  name        String      @unique
  slug        String      @unique
  description String?
  articles    Article[]
  caseStudies CaseStudy[]
  faqs        FAQ[]
  createdAt   DateTime    @default(now())
}

model Tag {
  id        String    @id @default(uuid())
  name      String    @unique
  articles  Article[]
  createdAt DateTime  @default(now())
}

model Author {
  id        String    @id @default(uuid())
  name      String
  email     String?   @unique
  password  String?
  roleType  String    @default("Author & Contributor")
  title     String
  bio       String?
  avatarUrl String?
  linkedin  String?
  status    String    @default("Active")
  lastLogin DateTime?
  articles  Article[]
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}

model Media {
  id        String   @id @default(uuid())
  filename  String
  url       String
  mimeType  String
  sizeBytes Int
  storage   String   @default("Cloudflare_R2") // Cloudflare_R2, AWS_S3, Local
  createdAt DateTime @default(now())
}

model Redirect {
  id         String   @id @default(uuid())
  fromUrl    String   @unique
  toUrl      String
  statusCode Int      @default(301)
  createdAt  DateTime @default(now())
}

model AnalyticsEvent {
  id         String   @id @default(uuid())
  eventName  String
  pageUrl    String
  utmSource  String?
  sessionId  String?
  ipAddress  String?
  createdAt  DateTime @default(now())
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  target    String
  ipAddress String?
  createdAt DateTime @default(now())
}

model PlatformLogo {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  logoUrl     String?
  svgCode     String?  @db.Text
  websiteUrl  String?
  orderIndex  Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BrandLogo {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  category    String?
  logoUrl     String?
  svgCode     String?  @db.Text
  websiteUrl  String?
  orderIndex  Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProductCategory {
  id            String   @id @default(uuid())
  name          String   @unique
  slug          String   @unique
  description   String?
  subcategories String[] // e.g. Fans, Aircooler, Water Heater, Room Heater for Seasonal
  icon          String?
  orderIndex    Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SiteConfiguration {
  id                  String   @id @default("default")
  companyName         String   @default("Good Life Sutra Pvt. Ltd.")
  phone               String   @default("+91 88821 57074")
  email               String   @default("growth@goodlifesutra.com")
  address             String   @default("Plot 42, Udyog Vihar Phase IV, Sector 18, Gurugram, Haryana 122015, India")
  gstNumber           String   @default("06AABCG1234F1Z8")
  whatsappNumber      String   @default("+91 88821 57074")
  headerCtaText       String   @default("Request Diagnostic →")
  heroHeadline        String   @default("Scale Ecommerce. Not Complexity.")
  announcementText    String   @default("Operating across 15+ Platforms & 23+ Leading Brands Nationwide")
  announcementEnabled Boolean  @default(true)
  announcementLink    String   @default("/case-studies")
  announcementTheme   String   @default("slate")
  headerPhoneBadge    String?  @default("+91 88821 57074")
  cinNumber           String?  @default("U74999MH2021PTC368942")
  registeredCity      String?  @default("Gurugram, Haryana & Mumbai, India")
  supportHours        String?  @default("Mon - Sat: 9:30 AM - 7:00 PM IST")
  preFooterTag        String?  @default("READY TO SCALE?")
  preFooterHeading    String?  @default("Grow your ecommerce business with us")
  preFooterSubtext    String?  @default("Request our complimentary Commerce Diagnostic to identify leakage points and unlock new channel growth.")
  preFooterCta        String?  @default("UNLOCK YOUR GROWTH →")
  preFooterBgImage    String?  @default("https://images.unsplash.com/photo-1600880292203-757bb62b4baf?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80")
  copyrightText       String?  @default("© 2026 Good Life Sutra Pvt. Ltd. All rights reserved.")
  linkedinUrl         String?  @default("https://linkedin.com/company/good-life-sutra")
  twitterUrl          String?  @default("https://x.com/goodlifesutra")
  youtubeUrl          String?  @default("https://youtube.com/@goodlifesutra")
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())
}


