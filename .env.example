# Good Life Sutra — Environment Variables Template
# Copy this file to .env and fill in your actual values

# ─── DATABASE (Local PostgreSQL via pgAdmin) ───────────────────────────────
# Install PostgreSQL locally: https://www.postgresql.org/download/windows/
# Manage via pgAdmin 4: https://www.pgadmin.org/download/
# Create a new database named: goodlife_db
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/goodlife_db"

# ─── NEXT.JS PUBLIC API URL ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:5000"

# ─── BACKEND JWT AUTH ──────────────────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
JWT_REFRESH_SECRET="your-refresh-secret-jwt-key-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── EMAIL (SMTP) ──────────────────────────────────────────────────────────
# Use Gmail App Password or Mailgun/SendGrid
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-gmail-app-password"
SMTP_FROM="Good Life Sutra <no-reply@goodlifesutra.com>"
ADMIN_EMAIL="leads@goodlifesutra.com"

# ─── MEDIA STORAGE (Cloudflare R2 or AWS S3) ──────────────────────────────
S3_BUCKET_NAME="goodlife-media"
S3_REGION="ap-south-1"
S3_ACCESS_KEY_ID="your-access-key-id"
S3_SECRET_ACCESS_KEY="your-secret-access-key"
S3_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"

# ─── REDIS (Upstash or local Redis) ───────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── ANALYTICS ────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA4_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"
NEXT_PUBLIC_META_PIXEL_ID="XXXXXXXXXXXXXXX"

# ─── WHATSAPP BUSINESS API ────────────────────────────────────────────────
WHATSAPP_API_TOKEN="your-whatsapp-business-api-token"
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"

# ─── GOOGLE CALENDAR (Booking CTA) ────────────────────────────────────────
NEXT_PUBLIC_CALENDAR_BOOKING_URL="https://calendly.com/goodlifesutra/commerce-diagnostic"

# ─── SECURITY ─────────────────────────────────────────────────────────────
CORS_ORIGIN="http://localhost:3000,https://goodlifesutra.com"
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
